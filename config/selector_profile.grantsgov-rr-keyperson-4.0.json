          "options": ["", "PD/PI", "Co-PD/PI", "Faculty", "Post Doctoral", "Post Doctoral Associate", "Post Doctoral Scholar",
                      "Other Professional", "Graduate Student", "Undergraduate Student", "Technician", "Consultant",
                      "Co-Investigator", "Other (Specify)"] },
        { "id_template": "personOtherProjectRole{N}",  "label": "Other Project Role Category",         "type": "text",   "required": false, "conditional": "projectRole == 'Other (Specify)'" },
        { "id_template": "personDegreeType{N}",        "label": "Degree Type",                         "type": "text",   "required": false },
        { "id_template": "personDegreeYear{N}",        "label": "Degree Year",                         "type": "text",   "required": false },
        { "id_template": "personBioSketchsFile{N}",    "label": "Attach Biographical Sketch",          "type": "file",   "required": true  },
        { "id_template": "personSupportsFile{N}",      "label": "Attach Current & Pending Support",    "type": "file",   "required": false }
      ]
    }
  }
