        { "id_template": "personTitle{N}",             "label": "Position/Title",                      "type": "text",   "required": false },
        { "id_template": "personOrganization{N}",      "label": "Organization Name",                   "type": "text",   "required": false },
        { "id_template": "personDepartment{N}",        "label": "Department",                          "type": "text",   "required": false },
        { "id_template": "personDivision{N}",          "label": "Division",                            "type": "text",   "required": false },
        { "id_template": "personStreet1{N}",           "label": "Street1",                             "type": "text",   "required": false },
        { "id_template": "personStreet2{N}",           "label": "Street2",                             "type": "text",   "required": false },
        { "id_template": "personCity{N}",              "label": "City",                                "type": "text",   "required": false },
        { "id_template": "personCounty{N}",            "label": "County / Parish",                     "type": "text",   "required": false },
        { "id_template": "personState{N}",             "label": "State",                               "type": "select", "required": false },
        { "id_template": "personProvince{N}",          "label": "Province",                            "type": "text",   "required": false },
        { "id_template": "personCountry{N}",           "label": "Country",                             "type": "text",   "required": false },
        { "id_template": "personZipCode{N}",           "label": "ZIP / Postal Code",                   "type": "text",   "required": false },
        { "id_template": "personPhoneNumber{N}",       "label": "Phone Number",                        "type": "text",   "required": false },
        { "id_template": "personFaxNumber{N}",         "label": "Fax Number",                          "type": "text",   "required": false },
        { "id_template": "personEmail{N}",             "label": "Email",                               "type": "text",   "required": false },
        { "id_template": "personCredential{N}",        "label": "Credential / Agency Login",           "type": "text",   "required": false },
