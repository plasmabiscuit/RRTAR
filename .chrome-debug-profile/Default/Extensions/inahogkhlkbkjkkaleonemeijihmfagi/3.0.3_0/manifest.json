{
   "action": {
      "default_popup": "./popup.html"
   },
   "author": "Microsoft",
   "background": {
      "service_worker": "sp-page-diagnostics-background.js",
      "type": "module"
   },
   "content_scripts": [ {
      "js": [ "sp-page-diagnostics-content-script-entry.js" ],
      "matches": [ "\u003Call_urls>" ],
      "run_at": "document_start"
   } ],
   "default_locale": "en",
   "description": "__MSG_Description__",
   "host_permissions": [ "https://*/*" ],
   "icons": {
      "128": "images/icon128.png",
      "16": "images/icon16.png",
      "32": "images/icon32.png"
   },
   "key": "",
   "manifest_version": 3,
   "name": "__MSG_AppName__",
   "permissions": [ "webNavigation", "downloads", "tabs", "activeTab", "alarms", "debugger", "scripting", "webRequest", "storage", "declarativeNetRequestWithHostAccess" ],
   "short_name": "SPPageDiag",
   "update_url": "https://clients2.google.com/service/update2/crx",
   "version": "3.0.3",
   "web_accessible_resources": [ {
      "matches": [ "https://*/*" ],
      "resources": [ "classic/contentScript/pageNetwork.js", "classic/contentScript/registerListener.js", "classic/jquery/jquery.min.js", "modern-injected-script.js", "classic-injected-script.js", "sp-page-diagnostics-content-script-entry.js", "sp-page-diagnostics-content-script-core.js" ]
   } ]
}
