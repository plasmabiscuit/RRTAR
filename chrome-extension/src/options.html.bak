<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <title>RRTAR Extension Settings</title>
    <style>
      body {
        margin: 24px;
        max-width: 720px;
        font-family: Arial, sans-serif;
        color: #17212b;
      }

      h1 {
        margin-top: 0;
      }

      .field {
        display: grid;
        gap: 6px;
        margin-bottom: 16px;
      }

      input,
      button {
        font: inherit;
        padding: 8px 10px;
      }

      button {
        border: 1px solid #2357a5;
        background: #2357a5;
        color: #fff;
        cursor: pointer;
      }

      #status {
        margin-top: 16px;
        white-space: pre-wrap;
      }
    </style>
  </head>
  <body>
    <h1>RRTAR Extension Settings</h1>
    <p>This build is clientside. There is no backend or dashboard URL to configure.</p>
    <p>The extension dashboard stores manifests and uploaded files inside the browser.</p>
    <button id="open-dashboard-btn" type="button">Open Dashboard</button>
    <div id="status"></div>
    <script type="module" src="./options.js"></script>
  </body>
</html>
